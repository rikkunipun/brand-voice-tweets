# Copy this file to .env and fill in your key. Never commit .env.
OPENAI_API_KEY=

# Model used for any step without its own setting below. Research is a search call, so the mini model is enough;
# analysis, tweets and critic use the stronger model (see CLAUDE.md).
# Run `npm run check-access` to see which models your key can use.
MODEL_DEFAULT=gpt-5-mini
MODEL_RESEARCH=gpt-5-mini
MODEL_ANALYSIS=gpt-5.6-sol
MODEL_TWEETS=gpt-5.6-sol
MODEL_CRITIC=gpt-5.6-sol

# Reasoning effort for reasoning models (low | medium | high).
# Set to "none" if you switch to a non-reasoning model, which rejects this parameter.
REASONING_EFFORT=low

# Only used to ESTIMATE cost, and only for models missing from MODEL_PRICES in lib/config.js. Check your dashboard for real spend.
PRICE_INPUT_PER_M=0.25
PRICE_OUTPUT_PER_M=2.00
PRICE_PER_SEARCH=0.01
